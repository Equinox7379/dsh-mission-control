{
  "name": "dsh-mission-control",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "protocol-vendor",
    "cordis.patch.yml",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "pack:built": "node scripts/pack-from-build.mjs",
    "sync-protocol": "node scripts/sync-desktop-protocol.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/health-browser-smoke.mjs",
    "test:execution-browser": "node tests/execution-browser-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.4",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.4"
  }
}
