{
  "name": "dsh-mission-control",
  "version": "0.3.0-rc.1",
  "description": "DeepSeek Harness task workbench with explicit dispatch, execution observation and human acceptance.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Equinox7379/dsh-mission-control.git" },
  "homepage": "https://github.com/Equinox7379/dsh-mission-control#readme",
  "bugs": { "url": "https://github.com/Equinox7379/dsh-mission-control/issues" },
  "keywords": ["deepseek", "dsh", "ai-agents", "mission-control", "task-management", "local-first"],
  "engines": { "node": ">=22" },
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./cordis.patch.yml": "./cordis.patch.yml", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "package.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "pack:built": "node scripts/pack-from-build.mjs",
    "sync-protocol": "node scripts/sync-desktop-protocol.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/health-browser-smoke.mjs",
    "test:execution-browser": "node tests/execution-browser-smoke.mjs",
    "test:workbench": "node tests/workbench-browser.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-api-session-controller", "@deepseek-ai/dsh-api-workspace-controller", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-slots"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "playwright": "1.62.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2"
  }
}
