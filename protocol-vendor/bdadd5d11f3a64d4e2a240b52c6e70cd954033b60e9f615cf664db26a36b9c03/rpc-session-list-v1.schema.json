{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/protocol/rpc-session-list-v1.schema.json",
  "title": "session.list@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["method", "request", "response"],
  "properties": {
    "method": { "const": "session.list" },
    "request": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "response": {
      "type": "object", "additionalProperties": false, "required": ["items"],
      "properties": {
        "items": {
          "type": "array", "maxItems": 200,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["sessionId", "running", "blank"],
            "properties": {
              "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 },
              "running": { "type": "boolean" },
              "blank": { "type": "boolean" }
            }
          }
        },
        "currentSessionId": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
